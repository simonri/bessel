{
  "name": "@bessel/desktop",
  "version": "0.1.59",
  "description": "Bessel personal dashboard desktop app",
  "author": "Simon Risberg",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "predev": "tsc",
    "dev": "concurrently -k -n WEB,ELECTRON,TS -c cyan,yellow,blue \"pnpm --filter=@bessel/web dev\" \"wait-on http://localhost:3001 && env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox --no-zygote --disable-dev-shm-usage\" \"tsc -w --preserveWatchOutput\"",
    "compile": "tsc && pnpm --filter=@bessel/web build",
    "build": "pnpm run compile && electron-builder --config electron-builder.config.ts",
    "build:dir": "pnpm run compile && electron-builder --dir --config electron-builder.config.ts",
    "test": "vp test run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "chokidar": "^6.0.0",
    "dbus-next": "^0.10.2",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "wait-on": "^9.5.1"
  }
}
