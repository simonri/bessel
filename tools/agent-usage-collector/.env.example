# Copy to ~/.config/bessel/agent-usage-collector.env (referenced by the systemd
# unit's EnvironmentFile=) and fill in real values. Never commit the filled-in copy.

# Optional overrides — defaults are usually fine:
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json
# CLAUDE_PROJECTS_PATH=~/.claude/projects
# DEVICE_NAME=my-laptop

BESSEL_API_BASE_URL=https://bessel.example.com
BESSEL_INTERNAL_API_KEY=changeme
